<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.email.daily-triage</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/kirolos/Documents/Email-Scanner/.venv/bin/python</string>
    <string>/Users/kirolos/Documents/Email-Scanner/daily_triage.py</string>
    <string>daily</string>
    <string>--config</string>
    <string>/Users/kirolos/Documents/Email-Scanner/label-config.example.json</string>
    <string>--templates</string>
    <string>/Users/kirolos/Documents/Email-Scanner/templates</string>
    <string>--state-path</string>
    <string>/Users/kirolos/Documents/Email-Scanner/triage-state/daily-state.json</string>
    <string>--token-path</string>
    <string>/Users/kirolos/Documents/Email-Scanner/tokens/coach.json</string>
    <string>--apply</string>
    <string>--yes</string>
    <string>--scheduled</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kirolos/Documents/Email-Scanner</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/kirolos/Documents/Email-Scanner/automation-logs/daily-triage.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kirolos/Documents/Email-Scanner/automation-logs/daily-triage.err.log</string>
</dict>
</plist>
