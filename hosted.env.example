# Hosted status service configuration. Copy the VALUES into Cloud Run's
# environment settings; never commit a filled-in copy of this file.
#
# HostedConfig refuses to start if any of these is missing or unsafe, and
# additionally probes the state volume at boot, so a misconfigured deploy
# fails immediately rather than serving something weaker than intended.

# --- Read by hosted_wsgi (the status service) ---------------------------

# Where the connection record, the active directory and the archive live.
# MUST be a durable POSIX volume. On Cloud Run that means a Filestore (NFS)
# mount: the container's own filesystem is discarded on every recycle, and a
# GCS-FUSE mount supports neither atomic rename nor advisory locking, both of
# which the lifecycle relies on. The service probes for these at boot and
# refuses to start if they are absent.
HOSTED_STATE_ROOT=/mnt/state

# SECRET. Authorizes GET /. At least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# /healthz needs no credential and discloses only liveness.
HOSTED_OPERATOR_BEARER=

# Whether to require X-Forwarded-Proto: https. Leave unset (defaults to true)
# behind Cloud Run, which terminates TLS and overwrites the header. Set to
# false ONLY for local testing, where nothing sets it.
# HOSTED_REQUIRE_FORWARDED_HTTPS=true

# --- Read by the process that loads a credential, NOT by this service ---
#
# Listed here so the whole deployment's configuration is in one place. The
# status service cannot reach a token and does not read these.

# The Cloud KMS key wrapping the token's data key. Provision it yourself:
#   gcloud kms keyrings create triage --location <LOCATION>
#   gcloud kms keys create connection-kek --location <LOCATION> \
#       --keyring triage --purpose encryption
# Grant the runtime service account roles/cloudkms.cryptoKeyEncrypterDecrypter
# on this key and nothing broader.
# CONNECTION_KMS_KEY=projects/P/locations/L/keyRings/triage/cryptoKeys/connection-kek
