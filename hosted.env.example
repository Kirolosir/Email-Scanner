# Hosted status service configuration.
#
# Deployed as /etc/email-scanner/hosted.env, owned root:email-scanner, mode
# 0640. Never committed with values filled in, never passed on a command line.
#
# HostedConfig refuses to start if any of these is missing or unsafe, and
# additionally probes the state volume at boot, so a misconfigured deploy
# fails immediately rather than serving something weaker than intended.

# --- Read by hosted_wsgi (the status service) ---------------------------

# Where the connection record, the active directory and the archive live.
# MUST be a durable POSIX volume: the lifecycle relies on atomic rename
# (os.replace) and advisory locking (fcntl.flock) for every state write and
# the run lease. A Compute Engine persistent disk formatted ext4 provides
# both natively. A GCS-FUSE mount provides neither and is refused.
#
# Verify a freshly mounted disk before trusting it with anything:
#   python hosted_status.py --check-state-root /mnt/state --require-mountpoint
HOSTED_STATE_ROOT=/mnt/state

# SECRET. Authorizes GET /. At least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# /healthz needs no credential and discloses only liveness.
HOSTED_OPERATOR_BEARER=

# Require that HOSTED_STATE_ROOT is genuinely a mount point. Defaults to true
# and should stay true on the VM. An unmounted disk does not make the path
# disappear - the mountpoint directory still exists on the boot disk and
# passes every other check - so without this the service would write a real
# connection record to the wrong disk and lose it when the intended disk was
# mounted over the top.
# HOSTED_REQUIRE_MOUNTPOINT=true

# Require X-Forwarded-Proto: https. Defaults to true. Set to false for the
# loopback deployment, where the service is reached over an SSH tunnel and
# nothing sets the header. Leave it true if the service is ever put behind a
# load balancer that terminates TLS.
HOSTED_REQUIRE_FORWARDED_HTTPS=false

# --- Read by the process that loads a credential, NOT by this service ---
#
# Listed here so the whole deployment's configuration is in one place. The
# status service cannot reach a token and does not read these.

# The Cloud KMS key wrapping the token's data key. Provision it yourself:
#   gcloud kms keyrings create triage --location <LOCATION>
#   gcloud kms keys create connection-kek --location <LOCATION> \
#       --keyring triage --purpose encryption
# Grant the VM's service account roles/cloudkms.cryptoKeyEncrypterDecrypter
# on this key and nothing broader.
# CONNECTION_KMS_KEY=projects/P/locations/L/keyRings/triage/cryptoKeys/connection-kek

# Installed-app OAuth client. The runner combines this with the separately
# encrypted refresh token in memory; it never writes a plaintext token file.
# Store the real file outside the checkout, root:email-scanner mode 0640.
GMAIL_CREDENTIALS_PATH=/etc/email-scanner/credentials.json
