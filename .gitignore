# Gmail OAuth
credentials.json
token*.json
tokens/
client_secret*.json

# OAuth broker operator key. Losing this means sealed credentials can never
# be opened; committing it means anyone with the repo can open them.
*.key
broker-operator*
broker.env
!broker.env.example

# Secrets
.env
.env.*
!.env.example

# Per-run campaign draft-id logs (keep locally; needed for --undo)
draft-logs/
*.log

# Daily triage private journal and scheduler output
triage-state/
automation-logs/
daily-state*.json
audit-reports/
campaign-approval*.json
!campaign-approval.example.json
template-approval*.json
!template-approval.example.json
ai-drafting-approval*.json
!drafting-approval.example.json
account-config*.json
!account-config.generated.example.json
# Drafted wording guidance for an account that is not live yet. Contains no
# secret, no approval, and no confirmation - it is inert configuration kept
# in the repo so it can be reviewed before it is ever used.
!account-config.prepared.json
taxonomy-confirmation*.json

# Private per-account runtime profiles, approvals, and taxonomy reviews.
# Shipped examples stay at the repository root; real account artifacts live
# in these directories and must never be committed.
accounts/
review/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# A downloaded Cloud SDK is a machine tool, never project source.
gcloud --version/
google-cloud-sdk/

# OS
.DS_Store
body.txt
testbody.txt

# Account-specific scheduler jobs. The .example template is tracked; a real
# one names the account and its token path, so it stays local.
launchd/*.plist
!launchd/*.plist.example
