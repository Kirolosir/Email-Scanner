# OAuth broker configuration. Copy the VALUES into the host's environment
# settings; never commit a filled-in copy of this file.
#
# Every variable is required. BrokerConfig refuses to start if any is
# missing or unsafe, so a misconfigured deploy fails at boot rather than
# serving a broker that quietly skips a check.

# --- From the Google Cloud OAuth client (type: Web application) ----------
# The client id is not secret. The secret is.
BROKER_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# SECRET. Set this only in the host's environment settings, never in a file
# in the repo, never on a command line, never in a log. It is used solely in
# the server-side token exchange and never appears in a response.
BROKER_CLIENT_SECRET=

# Must be https and must match the Authorized redirect URI registered on the
# Google OAuth client EXACTLY, including scheme, host, and path.
BROKER_REDIRECT_URI=https://your-broker-host.example.com/callback

# The PUBLIC half of the operator keypair, hex encoded.
#   python broker_client.py keygen --private-out broker-operator.key
# The private half stays on the operator's machine. If this is wrong, the
# broker seals credentials nobody can open.
BROKER_OPERATOR_PUBLIC_KEY=

# SECRET. Authorizes /pickup. At least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BROKER_OPERATOR_BEARER=

# Comma-separated invite ids, minted offline:
#   python broker_client.py mint-invite
# Nothing reachable over the network can create an invite. Adding one means
# editing this variable and restarting the instance.
BROKER_INVITE_IDS=
