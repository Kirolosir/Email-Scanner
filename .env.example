# Copy to .env and keep the real file private (chmod 600 .env on POSIX).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THROTTLE_SECONDS=1
GEMINI_MIN_THROTTLE_SECONDS=0.25
GEMINI_MAX_THROTTLE_SECONDS=30
GEMINI_MAX_BACKOFF_SECONDS=30
GEMINI_GRAD_YEARS=2026,2027,2028,2029,2030

# Classifier input is also bounded locally. The reviewed default is 8,000
# cleaned current-message characters; override per run with --max-body-chars.

# Select which separately authorized Gmail account the tools use.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Daily triage uses label-config.example.json and triage-state/daily-state.json
# by default. For the coach account, select its separate token only after
# institutional IT approves OAuth and authorization succeeds:
# GMAIL_TOKEN_PATH=tokens/coach.json
