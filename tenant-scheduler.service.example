[Unit]
Description=Email-Scanner tenant scheduler
Documentation=file:///opt/email-scanner/DETAILS.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=email-scanner
Group=email-scanner
WorkingDirectory=/opt/email-scanner
EnvironmentFile=/etc/email-scanner/hosted.env
ExecStart=/opt/email-scanner/.venv/bin/python /opt/email-scanner/tenant_scheduler.py

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
